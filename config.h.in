/* config.h.in - libmodbus configuration header */

#ifndef LIBMODBUS_CONFIG_H
#define LIBMODBUS_CONFIG_H

/* Define if building for Windows (native, not Cygwin) */
#cmakedefine OS_WIN32 @LIBMODBUS_OS_WINDOWS@

/* Define if building for QNX */
#cmakedefine OS_QNX @LIBMODBUS_OS_QNX@

/* Define if building for Solaris */
#cmakedefine OS_SUNOS @LIBMODBUS_OS_SUNOS@

/* Windows version */
#cmakedefine WINVER @WINVER@

/* System headers */
#cmakedefine HAVE_ARPA_INET_H @HAVE_ARPA_INET_H@
#cmakedefine HAVE_BYTESWAP_H @HAVE_BYTESWAP_H@
#cmakedefine HAVE_ERRNO_H @HAVE_ERRNO_H@
#cmakedefine HAVE_FCNTL_H @HAVE_FCNTL_H@
#cmakedefine HAVE_LIMITS_H @HAVE_LIMITS_H@
#cmakedefine HAVE_NETDB_H @HAVE_NETDB_H@
#cmakedefine HAVE_NETINET_IN_H @HAVE_NETINET_IN_H@
#cmakedefine HAVE_NETINET_IP_H @HAVE_NETINET_IP_H@
#cmakedefine HAVE_NETINET_TCP_H @HAVE_NETINET_TCP_H@
#cmakedefine HAVE_SYS_IOCTL_H @HAVE_SYS_IOCTL_H@
#cmakedefine HAVE_SYS_SOCKET_H @HAVE_SYS_SOCKET_H@
#cmakedefine HAVE_SYS_TIME_H @HAVE_SYS_TIME_H@
#cmakedefine HAVE_SYS_TYPES_H @HAVE_SYS_TYPES_H@
#cmakedefine HAVE_TERMIOS_H @HAVE_TERMIOS_H@
#cmakedefine HAVE_TIME_H @HAVE_TIME_H@
#cmakedefine HAVE_UNISTD_H @HAVE_UNISTD_H@
#cmakedefine HAVE_LINUX_SERIAL_H @HAVE_LINUX_SERIAL_H@
#cmakedefine HAVE_WINSOCK2_H @HAVE_WINSOCK2_H@

/* Function availability */
#cmakedefine HAVE_ACCEPT4 @HAVE_ACCEPT4@
#cmakedefine HAVE_GAI_STRERROR @HAVE_GAI_STRERROR@
#cmakedefine HAVE_GETADDRINFO @HAVE_GETADDRINFO@
#cmakedefine HAVE_GETTIMEOFDAY @HAVE_GETTIMEOFDAY@
#cmakedefine HAVE_INET_PTON @HAVE_INET_PTON@
#cmakedefine HAVE_INET_NTOP @HAVE_INET_NTOP@
#cmakedefine HAVE_SELECT @HAVE_SELECT@
#cmakedefine HAVE_SOCKET @HAVE_SOCKET@
#cmakedefine HAVE_STRERROR @HAVE_STRERROR@
#cmakedefine HAVE_STRLCPY @HAVE_STRLCPY@
#cmakedefine HAVE_STRUCT_TERMIOS2 @HAVE_STRUCT_TERMIOS2@

/* RS-485 support declarations */
#cmakedefine HAVE_DECL_TIOCSRS485 @HAVE_DECL_TIOCSRS485@
#cmakedefine HAVE_DECL_TIOCM_RTS @HAVE_DECL_TIOCM_RTS@

/* Cygwin detection */
#cmakedefine HAVE_DECL___CYGWIN__ @HAVE_DECL___CYGWIN__@

/* Use standard C inline or compiler-specific */
#if defined(__STDC_VERSION__) && __STDC_VERSION__ >= 199901L
# define HAVE_INLINE 1
#elif defined(__GNUC_GNU_INLINE__)
# define HAVE_INLINE 1
#else
# define inline
#endif

/* Large file support */
#ifndef _FILE_OFFSET_BITS
# define _FILE_OFFSET_BITS 64
#endif

#endif /* LIBMODBUS_CONFIG_H */
